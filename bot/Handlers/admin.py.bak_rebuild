# ===== редактирование участника =====
async def adm_edit_cb(call: CallbackQuery, state):
    try:
        pid = int(call.data.split(":")[2])
    except (IndexError, ValueError):
        return await call.answer()
    p = await db.get_participant(pid)
    if not p:
        return await call.answer("Участник не найден", show_alert=True)
    await state.update_data(edit_pid=pid, edit_name=p[1])
    await EditParticipant.name.set()
    await call.message.answer(
        f"✏️ Редактирование «{p[1]}» (id={pid})\n\n"
        f"Отправьте <b>новое имя</b> или /skip, чтобы оставить текущее.\n"
        f"Отмена: /cancel"
    )
    await call.answer()


async def edit_name_input(message: Message, state):
    text = (message.text or "").strip()
    if text and text != "/skip":
        data = await state.get_data()
        await db.update_participant_name(data["edit_pid"], text)
        await state.update_data(edit_name=text)
        await message.answer(f"✅ Имя изменено на «{text}».")
    await EditParticipant.photos.set()
    await message.answer(
        "📸 Отправьте <b>новые фото</b> (добавятся к текущим).\n"
        "Когда закончите — /done\n"
        "Пропустить: /skip"
    )


async def edit_photos_input(message: Message, state):
    fid = message.photo[-1].file_id
    data = await state.get_data()
    pid = data["edit_pid"]
    await db.append_participant_photos(pid, [fid])
    await message.answer("📸 Фото добавлено. Отправляйте ещё или /done.")


async def edit_photos_wrong(message: Message):
    await message.answer("Нужно фото, текст или /done.")


async def edit_done(message: Message, state):
    data = await state.get_data()
    await state.finish()
    await _audit(message.from_user, "participant_edit",
                 target_id=data.get("edit_pid"),
                 target_label=data.get("edit_name"))
    await message.answer(f"✅ Участник «{data.get('edit_name', '?')}» обновлён.")


async def edit_skip_photos(message: Message, state):
    data = await state.get_data()
    await state.finish()
    await _audit(message.from_user, "participant_edit",
                 target_id=data.get("edit_pid"),
                 target_label=data.get("edit_name"))
    await message.answer("✅ Сохранено (фото не добавлены).")


def register_handlers(dp: Dispatcher):
    dp.register_message_handler(cmd_cancel, commands=["cancel"], state="*")
    dp.register_message_handler(cmd_admin, IsAdmin(), commands=["admin"], state="*")

    dp.register_callback_query_handler(
        adm_add, IsAdmin(), lambda c: c.data == "adm:add", state="*"
    )
    dp.register_message_handler(
        add_name, IsAdmin(), state=AddParticipant.name, content_types=["text"]
    )
    dp.register_message_handler(
        add_photo_step, IsAdmin(), state=AddParticipant.photos,
        content_types=["photo"],
    )
    dp.register_message_handler(
        add_photo_wrong, IsAdmin(), state=AddParticipant.photos
    )
    dp.register_callback_query_handler(
        add_photos_done, IsAdmin(),
        lambda c: c.data == "add:done", state=AddParticipant.photos,
    )
    dp.register_callback_query_handler(
        add_photos_cancel, IsAdmin(),
        lambda c: c.data == "add:cancel", state="*",
    )

    dp.register_callback_query_handler(
