        f"Голоса за него также очищены."
    )


async def _user_label(bot, uid, username=None, full_name=None) -> str:
    """'@username (<code>123</code>)' или 'Имя (<code>123</code>)' или '<code>123</code>'."""
    if not username:
        uname, fname = await db.get_admin_info(uid)
        username = username or uname
        full_name = full_name or fname
    if not username:
        try:
            chat = await bot.get_chat(uid)
            username = chat.username
            if not full_name:
                full_name = chat.full_name
        except Exception:
            pass
    parts = []
    if username:
        parts.append(f"@{username}")
    elif full_name:
        parts.append(full_name)
    parts.append(f"<code>{uid}</code>")
    return " ".join(parts)


async def _resolve_user_input(bot, text: str):
    """Принимает '@username' или числовой ID.
    Возвращает (uid, username, full_name) или None.

    ВАЖНО: Bot API не умеет резолвить @username для обычных
    пользователей. Ищем в локальной БД known_users (кто уже
    писал боту), а для ID — вызываем get_chat."""
    text = (text or "").strip()
    if not text:
        return None

    if text.startswith("@"):
        uname = text[1:].lstrip("@")
        if not uname:
            return None
        # 1) локальный каталог
        row = await db.find_user_by_username(uname)
        if row:
            uid, stored_uname, full_name = row
            # Освежим username/full_name через API, если получится
            try:
                chat = await bot.get_chat(uid)
                return (uid, chat.username or stored_uname, chat.full_name or full_name)
            except Exception:
                return (uid, stored_uname, full_name)
        # 2) попробуем get_chat — вдруг это канал (для каналов работает)
        try:
            chat = await bot.get_chat(f"@{uname}")
            if chat.type in ("channel", "supergroup", "group"):
                # для не-user сущностей добавлять админом бессмысленно
                return None
        except Exception:
            pass
        return None

    if text.isdigit():
        uid = int(text)
        try:
            chat = await bot.get_chat(uid)
            uname = chat.username
            fname = chat.full_name or ""
            # закешируем, чтобы потом можно было найти по @username
            if uname or fname:
                await db.upsert_known_user(uid, uname, fname)
            return (uid, uname, fname)
        except Exception:
            return (uid, None, None)

    return None


async def _add_admin_by_id(bot, uid: int, added_by: int):
    """Возвращает (ok: bool, message: str)."""
    if uid in SUPERADMIN_IDS:
        return False, "Этот пользователь — суперадмин, он уже есть."
    if uid in ADMIN_IDS:
        return False, "Этот пользователь уже в ADMIN_IDS (.env)."
    if await db.is_admin(uid):
        return False, "Этот пользователь уже админ."

    uname = fname = None
    try:
        chat = await bot.get_chat(uid)
        uname = chat.username
        fname = chat.full_name
    except Exception:
        pass

    await db.add_admin(uid, uname, fname, added_by=added_by)
    await _audit(type("U", (), {"id": added_by, "username": None})(),
                 "admin_add", target_id=uid, target_label=uname)
    label = await _user_label(bot, uid, uname, fname)
    return True, f"✅ Пользователь {label} теперь админ."


async def cmd_admins(message: Message):
    env_supers = list(dict.fromkeys(SUPERADMIN_IDS + ADMIN_IDS))
    rows = await db.list_admins()

    db_supers = [r for r in rows if r[4] == 1]
    db_admins = [r for r in rows if r[4] != 1]

    lines = ["👥 <b>Управление админами</b>\n"]

    lines.append("🛡 <b>Суперадмины (.env, защищены):</b>")
    if env_supers:
        for uid in env_supers:
            label = await _user_label(message.bot, uid)
            lines.append(f"• {label} 🔒")
    else:
        lines.append("<i>—</i>")

    if db_supers:
        lines.append("\n⭐ <b>Суперадмины (через бота):</b>")
        for uid, uname, fname, _, _ in db_supers:
            disp = f"@{uname}" if uname else (fname or "")
            label = f"{disp} (<code>{uid}</code>)" if disp else f"<code>{uid}</code>"
            lines.append(f"• ⭐ {label}")

    if db_admins:
        lines.append("\n👤 <b>Обычные админы (через бота):</b>")
        for uid, uname, fname, _, _ in db_admins:
            disp = f"@{uname}" if uname else (fname or "")
            label = f"{disp} (<code>{uid}</code>)" if disp else f"<code>{uid}</code>"
            lines.append(f"• 👤 {label}")

    if not rows:
        lines.append("\n<i>Админов, добавленных через бота, пока нет.</i>")

    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton("➕ Добавить админа", callback_data="adm:adm_add"))

    for uid, uname, fname, _, is_super in rows:
        name = f"@{uname}" if uname else (fname or str(uid))
        if is_super == 1:
            kb.row(
                InlineKeyboardButton(
                    f"⬇️ Понизить {name}", callback_data=f"adm:adm_demote:{uid}"
                ),
                InlineKeyboardButton(
                    f"🗑 {name}", callback_data=f"adm:adm_del:{uid}"
                ),
            )
        else:
            kb.row(
                InlineKeyboardButton(
                    f"⭐ В суперадмины {name}", callback_data=f"adm:adm_promote:{uid}"
                ),
                InlineKeyboardButton(
                    f"🗑 {name}", callback_data=f"adm:adm_del:{uid}"
                ),
            )

    await message.answer("\n".join(lines), reply_markup=kb)


