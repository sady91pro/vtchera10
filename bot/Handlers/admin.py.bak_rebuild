async def add_admin_input(message: Message, state):
    text = (message.text or "").strip()
    resolved = await _resolve_user_input(message.bot, text)
    if not resolved:
        return await message.answer(
            "Не нашёл такого пользователя.\n\n"
            "Варианты:\n"
            "• <b>Числовой ID</b> — работает всегда. Узнать: "
            "@userinfobot (пусть человек сам пришлёт вам свой ID) "
            "или /myid у него.\n"
            "• <b>@username</b> — работает, только если человек "
            "уже писал этому боту (/start или любое сообщение).\n\n"
            "Отмена: /cancel"
        )
    uid, uname, fname = resolved
    await state.finish()
    ok, msg = await _add_admin_by_id(
        message.bot, uid, message.from_user.id
    )
    await message.answer(msg)


async def adm_adm_del_cb(call: CallbackQuery):
    try:
        uid = int(call.data.split(":")[2])
    except (IndexError, ValueError):
        return await call.answer()
    if uid in SUPERADMIN_IDS or uid in ADMIN_IDS:
        return await call.answer("Суперадмина удалить нельзя", show_alert=True)
    if uid == call.from_user.id:
        return await call.answer("Нельзя удалить самого себя", show_alert=True)
    if not await db.is_admin(uid):
        return await call.answer("Этот пользователь не админ", show_alert=True)

    await db.delete_admin(uid)
    await _audit(call.from_user, "admin_del", target_id=uid)
    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await call.message.answer(
        f"🗑 Админ <code>{uid}</code> удалён.\n"
        f"Он больше не имеет доступа к /admin."
    )
    await call.answer("Удалён")


async def _promote_admin(call: CallbackQuery):
    try:
        uid = int(call.data.split(":")[2])
    except (IndexError, ValueError):
        return await call.answer()
    if uid in SUPERADMIN_IDS or uid in ADMIN_IDS:
        return await call.answer("Уже суперадмин (.env)", show_alert=True)
    if not await db.is_admin(uid):
        return await call.answer("Этот пользователь не админ", show_alert=True)
    if await db.is_superadmin(uid):
        return await call.answer("Уже суперадмин", show_alert=True)

    label = await _user_label(call.bot, uid)
    await db.set_super(uid, True)
    await _audit(call.from_user, "admin_promote", target_id=uid)
    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await call.message.answer(
        f"⭐ {label} теперь <b>суперадмин</b>.\n"
        f"Может назначать других суперадминов."
    )
    await call.answer("Повышен")


async def _demote_admin(call: CallbackQuery):
    try:
        uid = int(call.data.split(":")[2])
