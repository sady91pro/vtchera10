# ------------------ добавление участника ------------------

_albums = {}


def _photos_kb(count: int) -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            f"✅ Готово ({count})", callback_data="add:done"
        ),
        InlineKeyboardButton("❌ Отмена", callback_data="add:cancel"),
    ]])


async def _flush_album(mg_id: str, bot):
    await asyncio.sleep(1.5)
    entry = _albums.pop(mg_id, None)
    if not entry:
        return
    photos = entry["photos"]
    chat_id = entry["chat_id"]
    state = entry["state"]
    data = await state.get_data()
    existing = data.get("photos", [])
    existing.extend(photos)
    await state.update_data(photos=existing)
    await bot.send_message(
        chat_id,
        f"📸 Из альбома добавлено: <b>{len(photos)}</b>.\n"
        f"Всего фото: <b>{len(existing)}</b>.",
        reply_markup=_photos_kb(len(existing)),
    )


async def adm_add(call: CallbackQuery, state):
    await AddParticipant.name.set()
    await state.update_data(photos=[])
    await call.message.answer("Введите имя участника (или /cancel):")
    await call.answer()


async def add_name(message: Message, state):
    name = (message.text or "").strip()
    if not name:
        return await message.answer("Имя не может быть пустым.")
    await state.update_data(name=name, photos=[])
    await AddParticipant.photos.set()
    await message.answer(
        f"Имя: «{name}»\n\n"
        f"Отправьте <b>фото</b> участника.\n"
        f"Можно несколько — по одному или альбомом.\n"
        f"Когда закончите — нажмите ✅ Готово.",
        reply_markup=_photos_kb(0),
    )


async def add_photo_step(message: Message, state):
    fid = message.photo[-1].file_id
    mg = message.media_group_id

    if mg:
        if mg not in _albums:
            _albums[mg] = {
                "photos": [],
                "chat_id": message.chat.id,
                "state": state,
            }
            asyncio.create_task(_flush_album(mg, message.bot))
        _albums[mg]["photos"].append(fid)
        return

    data = await state.get_data()
    photos = data.get("photos", [])
    photos.append(fid)
    await state.update_data(photos=photos)
    await message.answer(
        f"📸 Фото добавлено. Всего: <b>{len(photos)}</b>.",
        reply_markup=_photos_kb(len(photos)),
    )


async def add_photos_done(call: CallbackQuery, state):
    data = await state.get_data()
    photos = data.get("photos", [])
    if not photos:
        return await call.answer(
            "Сначала отправьте хотя бы одно фото", show_alert=True
        )
    name = data.get("name", "?")
    await db.add_participant(name, photos)
    await state.finish()
    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await call.message.answer(
        f"✅ Участник «{name}» добавлен с <b>{len(photos)}</b> фото."
    )
    await call.answer(f"Добавлен: {name}")


async def add_photos_cancel(call: CallbackQuery, state):
    await state.finish()
    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await call.message.answer("❌ Добавление отменено.")
    await call.answer()


async def add_photo_wrong(message: Message):
    await message.answer("Нужно отправить именно фото (не файл, не текст).")


async def cmd_cancel(message: Message, state):
    await state.finish()
    await message.answer("Отменено.")


# ------------------ управление ------------------

async def adm_open(call: CallbackQuery):
    await db.set_open(True)
    await _audit(call.from_user, "vote_open")
    await call.message.answer("🟢 Голосование открыто. Пользователи могут /vote")
    await call.answer()


async def adm_close(call: CallbackQuery):
    await db.set_open(False)
    await _audit(call.from_user, "vote_close")
    await call.message.answer("🔴 Голосование закрыто.")
    if await db.get_setting("announce_on_close") == "1":
        await _do_announce(call.bot, actor=call.from_user)
    await call.answer()


async def adm_list(call: CallbackQuery):
    parts = await db.get_participants()
    if not parts:
        return await call.message.answer(
            "Список пуст. Добавьте участников через ➕."
        )

    kb = InlineKeyboardMarkup(row_width=1)
    for row in parts:
        pid, name = row[0], row[1]
        kb.row(
            InlineKeyboardButton(
                f"✏️ {name}", callback_data=f"adm:edit:{pid}"
            ),
            InlineKeyboardButton(
                f"🗑 {name}", callback_data=f"adm:del:{pid}"
            ),
        )
    kb.add(InlineKeyboardButton(
        "❌ УДАЛИТЬ ВСЕХ", callback_data="adm:delall"
    ))

    await call.message.answer(
        f"📋 <b>Участники</b> ({len(parts)}):\n"
        f"Нажмите 🗑 рядом с именем, чтобы удалить участника "
        f"и все голоса за него.",
        reply_markup=kb,
    )
    await call.answer()


async def adm_del(call: CallbackQuery):
    try:
        pid = int(call.data.split(":")[2])
    except (IndexError, ValueError):
        return await call.answer()

    p = await db.get_participant(pid)
    if not p:
        return await call.answer("Участник уже удалён", show_alert=True)

    name = p[1]
    await db.delete_participant(pid)
    await _audit(call.from_user, "participant_del",
                 target_id=pid, target_label=name)

    try:
        await call.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await call.message.answer(
        f"🗑 Участник «{name}» (id={pid}) удалён.\n"
        f"Голоса за него также очищены."
    )
    await call.answer(f"Удалён: {name}", show_alert=True)


async def adm_delall(call: CallbackQuery):
