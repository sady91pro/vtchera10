# ===== аудит =====
ACTION_LABELS = {
    "vote_open": "🟢 Открыл(а) голосование",
    "vote_close": "🔴 Закрыл(а) голосование",
    "vote_reset": "🗑 Сбросил(а) голоса",
    "participant_add": "➕ Добавил(а) участника",
    "participant_del": "🗑 Удалил(а) участника",
    "participant_delall": "❌ Удалил(а) ВСЕХ участников",
    "participant_edit": "✏️ Изменил(а) участника",
    "admin_add": "👤 Добавил(а) админа",
    "admin_del": "🗑 Удалил(а) админа",
    "admin_promote": "⭐ Повысил(а) до суперадмина",
    "admin_demote": "⬇️ Понизил(а) до админа",
    "shuffle": "🔀 Перемешал(а) порядок",
    "backup": "💾 Скачал(а) бэкап",
    "broadcast": "📢 Сделал(а) рассылку",
    "announce": "🎉 Объявил(а) победителей",
    "schedule_set": "⏰ Установил(а) расписание",
}


async def _audit(user, action, target_id=None, target_label=None, details=None):
    try:
        await db.add_audit(
            actor_id=user.id,
            actor_username=user.username,
            action=action,
            target_id=target_id,
            target_label=target_label,
            details=details,
        )
    except Exception:
        pass


# ===== расписание =====
async def cmd_schedule_open(message: Message, command):
    args = (command.args or "").strip()
    try:
        dt = datetime.strptime(args, "%Y-%m-%d %H:%M")
    except ValueError:
        return await message.answer(
            "Формат: <code>/schedule_open 2026-10-31 20:00</code>\n"
            "Время — по часовому поясу сервера."
        )
    await db.set_setting("schedule_open_at", dt.isoformat())
    await _audit(message.from_user, "schedule_set",
                 details=f"open_at={dt.isoformat()}")
    await message.answer(
        f"⏰ Автооткрытие: <code>{dt.strftime('%Y-%m-%d %H:%M')}</code>\n"
        f"Голосование откроется автоматически."
    )


async def cmd_schedule_close(message: Message, command):
    args = (command.args or "").strip()
    try:
        dt = datetime.strptime(args, "%Y-%m-%d %H:%M")
    except ValueError:
        return await message.answer(
            "Формат: <code>/schedule_close 2026-10-31 23:00</code>"
        )
    await db.set_setting("schedule_close_at", dt.isoformat())
    await _audit(message.from_user, "schedule_set",
                 details=f"close_at={dt.isoformat()}")
    await message.answer(
        f"⏰ Автозакрытие: <code>{dt.strftime('%Y-%m-%d %H:%M')}</code>"
    )


async def cmd_unschedule(message: Message):
    await db.set_setting("schedule_open_at", "")
    await db.set_setting("schedule_close_at", "")
    await message.answer("⏰ Расписание очищено.")


