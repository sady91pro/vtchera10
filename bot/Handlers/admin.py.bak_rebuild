# ===== audit =====
async def _render_audit(limit=20, offset=0):
    total = await db.count_audit()
    if total == 0:
        return ("📜 <b>Аудит-лог пуст</b>", None)
    rows = await db.list_audit(limit=limit, offset=offset)
    page = offset // limit + 1
    pages = (total + limit - 1) // limit
    lines = [f"📜 <b>Аудит-лог</b> (стр {page}/{pages}, всего {total})\n"]
    for ts, aid, auname, act, tid, tlabel, details in rows:
        who = f"@{auname}" if auname else str(aid)
        label = ACTION_LABELS.get(act, act)
        extra = ""
        if tlabel:
            extra = f" «{tlabel}»"
        elif tid:
            extra = f" <code>{tid}</code>"
        if details and not tlabel:
            extra += f" — <i>{details[:80]}</i>"
        lines.append(f"• <code>{ts}</code> {who}\n  {label}{extra}")
    text = "\n".join(lines)
    kb = None
    if pages > 1:
        nav = []
        if offset > 0:
            nav.append(InlineKeyboardButton("⬅️", callback_data=f"audit:page:{page - 2}"))
        nav.append(InlineKeyboardButton(f"{page}/{pages}", callback_data="audit:noop"))
        if offset + limit < total:
            nav.append(InlineKeyboardButton("➡️", callback_data=f"audit:page:{page}"))
        if nav:
            kb = InlineKeyboardMarkup(inline_keyboard=[nav])
    return (text, kb)


async def cmd_audit(message: Message):
    text, kb = await _render_audit()
    if len(text) > 4000:
        for i in range(0, len(text), 4000):
            await message.answer(text[i:i + 4000])
    else:
        await message.answer(text, reply_markup=kb)


async def adm_audit_cb(call: CallbackQuery):
    await cmd_audit(call.message)
    await call.answer()


async def cb_audit_page(call: CallbackQuery):
    try:
        page = int(call.data.split(":")[2])
    except (IndexError, ValueError):
        return await call.answer()
    text, kb = await _render_audit(limit=20, offset=page * 20)
    try:
        await call.message.edit_text(text, reply_markup=kb)
    except Exception:
        await call.message.answer(text, reply_markup=kb)
    await call.answer()


# ===== announce =====
async def _do_announce(bot, actor=None):
    rows = await db.get_results()
    if not rows:
        return 0
    total = sum(r[2] for r in rows)
    if total == 0:
        return 0
    medals = ["🥇", "🥈", "🥉"]
    top = rows[:3]
    lines = ["🎉 <b>Победители конкурса костюмов!</b>\n"]
    for i, (_, name, cnt) in enumerate(top):
        pct = cnt * 100 // total if total else 0
        medal = medals[i] if i < 3 else f"{i + 1}."
        lines.append(f"{medal} <b>{name}</b> — {cnt} ({pct}%)")
    lines.append(f"\nВсего голосов: <b>{total}</b>")
    lines.append("\nСпасибо всем, кто голосовал! 🙌")
    text = "\n".join(lines)

    voter_ids = await db.get_voter_ids()
    sent = 0
    for uid in voter_ids:
        try:
            await bot.send_message(uid, text)
            sent += 1
        except Exception:
            pass
        await asyncio.sleep(0.05)

    if actor:
        await _audit(actor, "announce",
                     details=f"sent={sent}/{len(voter_ids)}")
    return sent


async def adm_announce_cb(call: CallbackQuery):
    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton("🎉 Объявить всем", callback_data="adm:announce:yes"),
        InlineKeyboardButton("❌ Отмена", callback_data="adm:announce:no"),
    ]])
    await call.message.answer(
        "🎉 Разослать объявление победителей всем, кто голосовал?",
        reply_markup=kb,
    )
    await call.answer()


