    await call.message.answer(
        f"⬇️ {label} понижен до <b>обычного админа</b>.\n"
        f"Больше не может управлять админами."
    )
    await call.answer("Понижен")


async def cmd_promote(message: Message, command):
    args = (command.args or "").strip()
    if not args:
        return await message.answer(
            "Использование: <code>/promote 123456789</code> "
            "или <code>/promote @username</code>"
        )
    resolved = await _resolve_user_input(message.bot, args)
    if not resolved:
        return await message.answer("Не удалось найти пользователя.")
    uid = resolved[0]
    if uid in SUPERADMIN_IDS or uid in ADMIN_IDS:
        return await message.answer("Уже суперадмин (.env).")
    if not await db.is_admin(uid):
        return await message.answer(
            f"Пользователь <code>{uid}</code> не админ. "
            f"Сначала /addadmin {uid}"
        )
    if await db.is_superadmin(uid):
        return await message.answer("Уже суперадмин.")
    label = await _user_label(message.bot, uid)
    await db.set_super(uid, True)
    await message.answer(
        f"⭐ {label} теперь суперадмин."
    )


