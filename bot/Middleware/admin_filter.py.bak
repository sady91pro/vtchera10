from aiogram.dispatcher.filters import BoundFilter

from bot.config import ADMIN_IDS, SUPERADMIN_IDS
from bot.Services import db


class IsAdmin(BoundFilter):
    async def check(self, obj) -> bool:
        user = getattr(obj, "from_user", None)
        if not user:
            return False
        if user.id in SUPERADMIN_IDS or user.id in ADMIN_IDS:
            return True
        if await db.is_admin(user.id):
            return True
        if user.username and await db.is_admin_by_username(user.username):
            return True
        return False


class IsSuperAdmin(BoundFilter):
    async def check(self, obj) -> bool:
        user = getattr(obj, "from_user", None)
        if not user:
            return False
        if user.id in SUPERADMIN_IDS or user.id in ADMIN_IDS:
            return True
        if await db.is_superadmin(user.id):
            return True
        if user.username and await db.is_superadmin_by_username(user.username):
            return True
        return False
